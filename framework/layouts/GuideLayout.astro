---
import BaseLayout from './BaseLayout.astro';
import QuickAnswer from '../components/QuickAnswer.astro';
import Toc from '../components/Toc.astro';
import AdSlot from '../components/AdSlot.astro';
import { articleJsonLd } from '../lib/seo';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}
interface Props {
  title: string;
  description: string;
  h1: string;
  section: string;
  verifiedAgainst: string;
  quickAnswer: string[];
  sources: { label: string; url: string }[];
  related: { href: string; label: string }[];
  headings: Heading[];
  banner: string;
  bannerAlt: string;
  toolsFirst?: boolean;
  extraJsonLd?: Record<string, unknown> | Record<string, unknown>[];
}
const props = Astro.props;
const article = articleJsonLd({
  title: props.title,
  description: props.description,
  pathname: Astro.url.pathname,
});
const extra = props.extraJsonLd
  ? Array.isArray(props.extraJsonLd)
    ? props.extraJsonLd
    : [props.extraJsonLd]
  : [];
---
<BaseLayout title={props.title} description={props.description} jsonLd={[article, ...extra]}>
  <main id="content" class="shell layout">
    <article class="guide">
      <header class="page-head">
        <div class="head-copy">
          <p class="crumbs"><a href="/">Home</a> / {props.section}</p>
          <p class="kicker">{props.section}</p>
          <h1>{props.h1}</h1>
          <p class="checked"><b>Sources checked</b> <span>{props.verifiedAgainst}</span></p>
        </div>
        <div class="banner-wrap">
          <img
            class="page-banner"
            src={props.banner}
            alt={props.bannerAlt}
            width="600"
            height="338"
            decoding="async"
          />
        </div>
      </header>
      {props.toolsFirst ? (
        <>
          <div class="prose">
            <slot />
          </div>
          <QuickAnswer sentences={props.quickAnswer} />
          <AdSlot name="afterQuickAnswer" />
        </>
      ) : (
        <>
          <QuickAnswer sentences={props.quickAnswer} />
          <AdSlot name="afterQuickAnswer" />
          <div class="toc-mobile">
            <Toc headings={props.headings} />
          </div>
          <div class="prose">
            <slot />
          </div>
        </>
      )}
      <section class="sources">
        <h2>Sources and last check</h2>
        <p>
          {props.verifiedAgainst} Where a number comes from a patch post and this site has not confirmed it in a current client, the page says so.
        </p>
        <ul>
          {props.sources.map((source) => (
            <li><a href={source.url}>{source.label}</a></li>
          ))}
        </ul>
        {props.related.length > 0 && (
          <>
            <h2>Related</h2>
            <ul class="related">
              {props.related.map((link) => (
                <li><a href={link.href}>{link.label}</a></li>
              ))}
            </ul>
          </>
        )}
      </section>
    </article>
    <aside class="side">
      <Toc headings={props.headings} />
    </aside>
  </main>
</BaseLayout>

<style>
  .page-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.95rem;
    align-items: center;
    padding-bottom: 0.95rem;
    margin-bottom: 1.05rem;
    border-bottom: 1px solid #3a465c;
  }
  .head-copy {
    min-width: 0;
  }
  .head-copy .checked {
    margin-bottom: 0;
  }
  .banner-wrap {
    order: -1;
    width: 100%;
    border-radius: 12px;
    overflow: hidden;
    border: 2px solid #3a465c;
    background: #0e1218;
  }
  .page-banner {
    display: block;
    width: 100%;
    height: auto;
  }
  @media (min-width: 760px) {
    .page-head {
      grid-template-columns: minmax(0, 1fr) 300px;
      gap: 1.3rem;
    }
    .banner-wrap {
      order: 0;
    }
  }
  .toc-mobile { margin: 0 0 1rem; }
  @media (max-width: 1039px) {
    .side { display: none; }
  }
  @media (min-width: 1040px) {
    .toc-mobile { display: none; }
  }
</style>
